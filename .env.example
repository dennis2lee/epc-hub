# Copy to .env.local and fill in. Never commit real values. See doc/setup.md.

# Supabase (local: `npm run db:status`; cloud: Project Settings > API Keys)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Church-local time zone (IANA name). Must match app_settings.time_zone in the DB.
NEXT_PUBLIC_CHURCH_TIME_ZONE=America/Los_Angeles

# Kakao Developers app (REST API key). Option 2 login uses these on the server.
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=

# Kakao option 1 (Supabase built-in provider). Read by `supabase start` from the shell
# environment; in the cloud they are set in the Supabase dashboard instead.
SUPABASE_AUTH_EXTERNAL_KAKAO_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_KAKAO_SECRET=

# Shared secret for the daily cron route (Vercel Cron sends it as a Bearer token).
CRON_SECRET=

# Email delivery. Leave RESEND_API_KEY empty to print emails to the server log.
RESEND_API_KEY=
MAIL_FROM=Church Intranet <no-reply@example.org>

# Public base URL used in email links (Vercel: the production domain).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shown on "account pending" screens.
NEXT_PUBLIC_OFFICE_PHONE=
