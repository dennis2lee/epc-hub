# Non-secret settings merged into the self-hosted .env by install.sh.
# Secrets (SMTP_PASS, KAKAO_*) are filled in by hand afterwards.
COMPOSE_FILE=docker-compose.yml:docker-compose.church.yml
SUPABASE_PUBLIC_URL=https://api.epcsj-hub.org
API_EXTERNAL_URL=https://api.epcsj-hub.org/auth/v1
SITE_URL=https://www.epcsj-hub.org
ADDITIONAL_REDIRECT_URLS=https://www.epcsj-hub.org/auth/callback**
DISABLE_SIGNUP=false
ENABLE_EMAIL_SIGNUP=true
ENABLE_EMAIL_AUTOCONFIRM=false
ENABLE_ANONYMOUS_USERS=false
ENABLE_PHONE_SIGNUP=false
ENABLE_PHONE_AUTOCONFIRM=false
# GoTrue sends login codes FROM this address (Resend-verified domain).
SMTP_ADMIN_EMAIL=no-reply@notify.epcsj-hub.org
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=
SMTP_SENDER_NAME=교회 지출청구
STUDIO_DEFAULT_ORGANIZATION=epcsj-hub
STUDIO_DEFAULT_PROJECT=intra-net
API_GW_HTTP_PORT=8000
CHURCH_DB_PORT=54329
CHURCH_EMAIL_PER_HOUR=100
KAKAO_ENABLED=true
KAKAO_REST_API_KEY=
KAKAO_CLIENT_SECRET=
