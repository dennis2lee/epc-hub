{
  "name": "intra-net",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:start": "supabase start --workdir src -x studio,realtime,imgproxy,edge-runtime,logflare,vector,supavisor",
    "db:stop": "supabase stop --workdir src",
    "db:status": "supabase status --workdir src",
    "db:reset": "supabase db reset --workdir src",
    "db:test": "supabase test db --workdir src",
    "db:types": "supabase gen types typescript --local --workdir src --schema public > src/lib/database.types.ts",
    "check": "npm run lint && npm run typecheck && npm run test",
    "test:int": "VITEST_INTEGRATION=1 vitest run"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "next": "16.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "^5",
    "vitest": "^5.1.1"
  }
}
